#!/bin/sh
# P3 webflash installer init - UNIVERSAL loader v2.
# Template placeholders (__WFS_SHA__, __DISK_END__) are replaced by mkfit.sh.
# Supports:
#   path A: P3WFS1 self-describing image (.wfs: 4096B header + xz payload)
#   path B: whole-disk image with GPT inside (xz / gzip / plain raw)
#           -> partitions are located from the IMAGE's own GPT and written to
#              the board's FIXED partitions (boot@32768, rootfs@819200).
# Hard product rule: bootarea (LBA0-32767: GPT + U-Boot) is NEVER written.
/bin/busybox mkdir -p /proc /sys /dev /tmp
/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev 2>/dev/null
export PATH=/bin

F=/system.img
EXPECT=__WFS_SHA__
DISK_END=__DISK_END__
BOOT_LBA=32768
ROOT_LBA=819200

echo
echo "=== P3 webflash installer (universal) ==="
echo "NOTE: bootarea (LBA0-32767: GPT + U-Boot) is NEVER written."

# 1) upload integrity
GOT=$(sha256sum $F | awk '{print $1}')
[ "$GOT" = "$EXPECT" ] || { echo UPLOAD_SHA_MISMATCH; exec sh; }

M6=$(head -c 6 $F)

if [ "$M6" = "P3WFS1" ]; then
  # ---------- path A: self-describing webflash image ----------
  H=$(head -c 4096 $F)
  START=$(echo "$H" | sed -n 's/^WRITE_LBA=//p')
  SECT=$(echo "$H" | sed -n 's/^IMAGE_SECTORS=//p')
  ISHA=$(echo "$H" | sed -n 's/^IMAGE_SHA256=//p')
  echo "$START" | grep -qE '^[0-9]+$' || { echo BAD_START; exec sh; }
  echo "$SECT"  | grep -qE '^[0-9]+$' || { echo BAD_SECTORS; exec sh; }
  echo "$ISHA"  | grep -qE '^[0-9a-f]{64}$' || { echo BAD_IMAGESHA; exec sh; }
  [ "$START" -ge 32768 ] || { echo REFUSE_WRITE_LBA_BELOW_32768; exec sh; }
  [ $((START+SECT)) -le "$DISK_END" ] || { echo REFUSE_IMAGE_EXCEEDS_DISK; exec sh; }
  echo "image: P3WFS1, $SECT sectors -> LBA$START..$((START+SECT-1))"

  # write
  TOTAL=$((SECT*512)); T0=$(date +%s)
  echo "step 3/5: writing image at LBA$START - DO NOT POWER OFF"
  (tail -c +4097 $F | xzcat | dd of=/dev/mmcblk0 bs=512 seek=$START conv=fsync 2>/tmp/dd.err) & P=$!
  while kill -0 $P 2>/dev/null; do
    sleep 5; EL=$(( $(date +%s) - T0 ))
    W=$(grep write_bytes /proc/$P/io 2>/dev/null | head -n1 | awk '{print $2}')
    if [ -n "$W" ] && [ "$W" -gt 0 ] 2>/dev/null; then
      echo "  writing... ${EL}s  $(( W / 1048576 ))MB / $(( TOTAL / 1048576 ))MB ($(( W * 100 / TOTAL ))%)"
    else echo "  writing... ${EL}s"; fi
  done
  wait $P; RC=$?; cat /tmp/dd.err
  [ $RC -eq 0 ] || { echo WRITE_FAIL; exec sh; }
  # readback vs header sha
  echo "step 4/5: readback verify $SECT sectors from LBA$START"
  T0=$(date +%s); TOTAL=$((SECT*512))
  (dd if=/dev/mmcblk0 bs=512 skip=$START count=$SECT 2>/dev/null | sha256sum >/tmp/v.out) & P=$!
  while kill -0 $P 2>/dev/null; do
    sleep 5; EL=$(( $(date +%s) - T0 ))
    R=$(grep rchar /proc/$P/io 2>/dev/null | head -n1 | awk '{print $2}')
    if [ -n "$R" ] && [ "$R" -gt 0 ] 2>/dev/null; then
      echo "  reading... ${EL}s  $(( R / 1048576 ))MB / $(( TOTAL / 1048576 ))MB ($(( R * 100 / TOTAL ))%)"
    else echo "  reading... ${EL}s"; fi
  done
  wait $P; cat /tmp/v.out
  grep -q $ISHA /tmp/v.out && { echo FLASH_OK; sync; sleep 3; reboot -f; } || { echo READBACK_MISMATCH; exec sh; }
  exec sh   # not reached
fi

# ---------- path B: whole-disk image (GPT inside) ----------
B2=$(head -c 2 $F | od -An -tx1 | tr -d ' \n')
case "$B2" in
  fd377a585a00) UNZIP="xzcat" ; KIND=xz ;;
  1f8b)         UNZIP="gunzip -c"; KIND=gzip ;;
  *)
    if dd if=$F bs=512 skip=1 count=1 2>/dev/null | grep -q 'EFI PART'; then
      UNZIP="cat"; KIND=raw
    else
      echo "BAD_FORMAT:$B2 (expected P3WFS1 / xz / gzip / raw GPT image)"; exec sh
    fi ;;
esac
[ -x /bin/gptparse ] || { echo NO_GPTPARSE_TOOL; exec sh; }

echo "image: whole-disk ($KIND), parsing its GPT (read-only, in memory)..."
$UNZIP $F 2>/dev/null | head -c 17408 > /tmp/hdr
PT=$(gptparse /tmp/hdr) || { echo GPT_PARSE_FAIL; exec sh; }
echo "$PT" | while read idx name a b; do echo "  part$idx: $name LBA$a..$b"; done

BOOT_OFF=$(echo "$PT" | awk '$2=="boot"{print $3; exit}')
ROOT_OFF=$(echo "$PT" | awk '$2=="rootfs"{print $3; exit}')
BOOT_SZ=$(echo "$PT"  | awk '$2=="boot"{print $4-$3+1; exit}')
ROOT_SZ=$(echo "$PT"  | awk '$2=="rootfs"{print $4-$3+1; exit}')
if [ -z "$BOOT_OFF" ] || [ -z "$ROOT_OFF" ] || [ -z "$BOOT_SZ" ] || [ -z "$ROOT_SZ" ]; then
  echo NO_BOOT_OR_ROOTFS_PARTITION; exec sh
fi
# disk capacity gates (targets are the board's FIXED partitions)
[ $((BOOT_LBA+BOOT_SZ)) -le "$DISK_END" ] || { echo REFUSE_BOOT_EXCEEDS_DISK; exec sh; }
[ $((ROOT_LBA+ROOT_SZ)) -le "$DISK_END" ] || { echo REFUSE_ROOTFS_EXCEEDS_DISK; exec sh; }

echo "plan: img boot@$BOOT_OFF($BOOT_SZ s) -> eMMC LBA$BOOT_LBA; img rootfs@$ROOT_OFF($ROOT_SZ s) -> eMMC LBA$ROOT_LBA"

# expected payload shas (from the image itself, 2 extra decompression passes)
echo "computing expected payload hashes (pass 1/3)..."
EBOOT=$($UNZIP $F 2>/dev/null | dd bs=512 skip=$BOOT_OFF count=$BOOT_SZ 2>/dev/null | sha256sum | awk '{print $1}')
EROOT=$($UNZIP $F 2>/dev/null | dd bs=512 skip=$ROOT_OFF count=$ROOT_SZ 2>/dev/null | sha256sum | awk '{print $1}')

flash_part() { # <img_off> <sect> <emmc_lba> <label>
  TOTAL=$(( $2 * 512 )); T0=$(date +%s)
  echo "step 3/5: writing $4 ($2 sectors) -> eMMC LBA$3 - DO NOT POWER OFF"
  ($UNZIP $F 2>/dev/null | dd of=/dev/mmcblk0 bs=512 skip=$1 count=$2 seek=$3 conv=fsync 2>/tmp/dd.err) & P=$!
  while kill -0 $P 2>/dev/null; do
    sleep 5; EL=$(( $(date +%s) - T0 ))
    W=$(grep write_bytes /proc/$P/io 2>/dev/null | head -n1 | awk '{print $2}')
    if [ -n "$W" ] && [ "$W" -gt 0 ] 2>/dev/null; then
      echo "  writing $4... ${EL}s  $(( W / 1048576 ))MB / $(( TOTAL / 1048576 ))MB ($(( W * 100 / TOTAL ))%)"
    else echo "  writing $4... ${EL}s"; fi
  done
  wait $P; RC=$?; cat /tmp/dd.err
  [ $RC -eq 0 ] || { echo WRITE_FAIL_$4; exec sh; }
}
flash_part $BOOT_OFF $BOOT_SZ $BOOT_LBA boot
flash_part $ROOT_OFF $ROOT_SZ $ROOT_LBA rootfs

# readback verify each fixed partition against image-derived hashes
verify_part() { # <emmc_lba> <sect> <expect_sha> <label>
  TOTAL=$(( $2 * 512 )); T0=$(date +%s)
  echo "step 4/5: readback verify $4 ($2 sectors from LBA$1)"
  (dd if=/dev/mmcblk0 bs=512 skip=$1 count=$2 2>/dev/null | sha256sum >/tmp/v_$4.out) & P=$!
  while kill -0 $P 2>/dev/null; do
    sleep 5; EL=$(( $(date +%s) - T0 ))
    R=$(grep rchar /proc/$P/io 2>/dev/null | head -n1 | awk '{print $2}')
    if [ -n "$R" ] && [ "$R" -gt 0 ] 2>/dev/null; then
      echo "  reading $4... ${EL}s  $(( R / 1048576 ))MB / $(( TOTAL / 1048576 ))MB ($(( R * 100 / TOTAL ))%)"
    else echo "  reading $4... ${EL}s"; fi
  done
  wait $P; cat /tmp/v_$4.out
  grep -q $3 /tmp/v_$4.out || { echo READBACK_MISMATCH_$4; exec sh; }
}
verify_part $BOOT_LBA $BOOT_SZ $EBOOT boot
verify_part $ROOT_LBA $ROOT_SZ $EROOT rootfs

echo FLASH_OK; sync; sleep 3; reboot -f
